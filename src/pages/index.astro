---
import { AppLoader } from '../components/AppLoader';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title>Climate Data Explorer</title>

    <!-- Open Graph tags -->
    <meta name="description" content="Explore daily global sea surface temperatures, anomalies, and trends on an interactive 3D globe powered by NOAA OISST data.">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Climate Data Explorer">
    <meta property="og:locale" content="en_US">
    <meta property="og:url" content="https://globe-viz.oberbrunner.com/">
    <meta property="og:title" content="Climate Data Explorer — Sea Surface Temperatures">
    <meta property="og:description" content="Interact with a 3D globe and time-series charts to explore sea surface temperatures, anomalies, and long-term trends from NOAA OISST.">
    <meta property="og:image" content="https://climate-change-assets.s3.amazonaws.com/sea-surface-temp/og/oisst-anom-global.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Stylized view of global sea surface temperature data with controls for anomalies and trends.">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Climate Data Explorer — Sea Surface Temperatures">
    <meta name="twitter:description" content="Animate daily SST data, compare anomalies, and explore long-term trends on an interactive globe.">
    <meta name="twitter:image" content="https://climate-change-assets.s3.amazonaws.com/sea-surface-temp/og/oisst-anom-global.jpg">
    <meta name="twitter:image:alt" content="Stylized view of global sea surface temperature data with controls for anomalies and trends.">

    <!-- featherstat analytics; cookie-less, prod hostname only. Dynamic import
         so the module is never even fetched off production. Views are announced
         here rather than by the tracker's history hook: this site rewrites the
         URL as its own state changes (lib/url-state.ts), which is one page
         being explored, not a series of page views. -->
    <script is:inline>
      if (location.hostname === 'globe-viz.oberbrunner.com') {
        import('https://analytics.oberbrunner.com/tracker.js').then(
          ({ init, page }) => {
            init({
              site: 3,
              endpoint: 'https://analytics.oberbrunner.com/api/collect',
              autoPageviews: false,
            });
            // A page that does not exist reports as one canonical /404 carrying
            // the URL that was asked for, so a mistyped or probed link stays
            // findable as a prop instead of becoming a page of its own.
            //
            // Two ways of knowing, because this site is one page and the host
            // is not yet known to serve a real 404: the marker is the 404 page
            // announcing itself, and the path check still catches a bad URL
            // while the host answers 200 with the app. Either way, one report.
            const missing =
              document.querySelector('meta[name="featherstat:missing"]') !==
                null ||
              (location.pathname !== '/' &&
                location.pathname !== '/index.html');
            missing
              ? page(new URL('/404', location.origin).href, document.title, {
                  missing: location.pathname.slice(0, 200),
                })
              : page();
          },
        );
      }
    </script>

    <!-- Set the active theme synchronously, before paint, to avoid FOUC.
         Reads themePref out of saved appState (set by Solid + saveState()),
         falling back to OS preference when unset or 'system'. -->
    <script is:inline>
      (() => {
        try {
          const saved = JSON.parse(localStorage.getItem('appState') || '{}');
          const pref = saved.themePref || 'system';
          const dark =
            pref === 'dark' ||
            (pref === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        } catch (_) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
  </head>
  <body data-active-tab="globe">
    <div class="loading">Loading&#8230;</div>
    <AppLoader client:only="solid-js" />
  </body>
</html>
